{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sistema",
      "destination": "/sistema/index.html",
      "permanent": false
    },
    {
      "source": "/apresentacao",
      "destination": "/2bip_apresentacao.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sistema/:path*",
      "destination": "/sistema/:path*"
    }
  ]
}
